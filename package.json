{
  "name": "autonomous-ai-creator",
  "version": "1.0.0",
  "description": "Autonomous AI Publishing Agent System",
  "main": "dist/server.js",
  "scripts": {
    "build": "npx prisma generate && tsc",
    "render-build": "npm install && npx prisma generate && npx prisma db push && npm run build",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init"
  },
  "keywords": [
    "autonomous",
    "ai",
    "publishing-agent",
    "openai",
    "express",
    "typescript",
    "prisma",
    "sqlite"
  ],
  "author": "Antigravity AI",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.6.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "node-cron": "^3.0.3",
    "nodemon": "^3.1.14",
    "openai": "^4.28.0",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.20",
    "@types/node-cron": "^3.0.11",
    "jsdom": "^30.0.1",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
