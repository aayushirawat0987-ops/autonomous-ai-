generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Agent {
  id        String   @id @default(uuid())
  name      String
  domain    String
  role      String   @default("AI Security Researcher")
  style     String   @default("technical, concise, analytical, skeptical, evidence-based, educational")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts    Post[]
  memories Memory[]
  logs     AgentLog[]
  attempts ImprovementAttempt[]
  missions Mission[]
  trends   EmergingTrend[]
}

model Post {
  id             String   @id @default(uuid())
  agentId        String
  title          String
  content        String
  rationale      String   @default("")
  whySelected    String   @default("")
  whyRelevantNow String   @default("")
  sources        String   @default("[]")
  topicUrl       String?
  topicSource    String?
  platform       String   @default("LinkedIn / X")
  status         String   @default("Published")
  publishedAt    DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model Memory {
  id         String   @id @default(uuid())
  agentId    String
  topicUrl   String
  topicTitle String
  summary    String
  coveredAt  DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, topicUrl])
}

model AgentLog {
  id        String   @id @default(uuid())
  agentId   String
  level     String   @default("INFO")
  message   String
  details   String?
  createdAt DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model ImprovementAttempt {
  id                    String   @id @default(uuid())
  agentId               String
  attemptNumber         Int
  content               String
  scores                String
  weaknesses            String
  improvementSuggestions String
  finalDecision         String
  createdAt             DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model Mission {
  id        String   @id @default(uuid())
  agentId   String
  status    String   @default("RUNNING")
  result    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model EmergingTrend {
  id                String   @id @default(uuid())
  agentId           String
  title             String
  confidence        Float
  securityScore     Float
  novelty           Float
  impact            Float
  timeliness        Float
  sourceDiversity   Float
  supportingSources Int
  isPublished       Boolean  @default(false)
  createdAt         DateTime @default(now())
  
  signals           String   @default("[]") // JSON string of connected topics
  
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
}
