generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Agent {
  id        String   @id @default(uuid())
  name      String
  domain    String
  role      String   @default("AI Security Researcher")
  style     String   @default("technical, concise, analytical, skeptical, evidence-based, educational")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts    Post[]
  memories Memory[]
  logs     AgentLog[]
  attempts ImprovementAttempt[]
}

model Post {
  id             String   @id @default(uuid())
  agentId        String
  title          String
  content        String
  rationale      String
  whySelected    String
  whyRelevantNow String
  sources        String
  topicUrl       String?
  topicSource    String?
  publishedAt    DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model Memory {
  id         String   @id @default(uuid())
  agentId    String
  topicUrl   String
  topicTitle String
  summary    String
  coveredAt  DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, topicUrl])
}

model AgentLog {
  id        String   @id @default(uuid())
  agentId   String
  level     String   @default("INFO")
  message   String
  details   String?
  createdAt DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model ImprovementAttempt {
  id                    String   @id @default(uuid())
  agentId               String
  attemptNumber         Int
  content               String
  scores                String
  weaknesses            String
  improvementSuggestions String
  finalDecision         String
  createdAt             DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
}
