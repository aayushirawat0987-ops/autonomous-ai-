generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Agent {
  id          String    @id @default(uuid())
  name        String
  domain      String
  role        String    @default("AI Security Researcher")
  style       String    @default("technical, concise, analytical, skeptical, evidence-based, educational")
  status      String    @default("STOPPED")
  isActive    Boolean   @default(false)
  currentTask String?
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  posts         Post[]
  memories      Memory[]
  logs          AgentLog[]
  attempts      ImprovementAttempt[]
  missions      Mission[]
  trends        EmergingTrend[]
  opportunities Opportunity[]

  @@index([isActive])
  @@index([status])
}

model Post {
  id                  String   @id @default(uuid())
  agentId             String
  title               String
  content             String
  topicCategory       String   @default("General Technology")
  topicRelevanceScore Float    @default(92)
  contentAngle        String   @default("Technical Explanation")
  postType            String   @default("Technical Breakdown")
  wordCount           Int      @default(0)
  minWordCount        Int      @default(500)
  targetWordCount     Int      @default(600)
  maxWordCount        Int      @default(700)
  accuracyScore       Float    @default(92)
  originalityScore    Float    @default(88)
  technicalScore      Float    @default(90)
  clarityScore        Float    @default(90)
  evidenceScore       Float    @default(90)
  overallQuality      Float    @default(90)
  factCheckStatus     String   @default("VERIFIED")
  criticStatus        String   @default("APPROVED")
  rewriteAttempts     Int      @default(0)
  rationale           String   @default("")
  whySelected         String   @default("")
  whyRelevantNow      String   @default("")
  sources             String   @default("[]")
  topicUrl            String?
  topicSource         String?
  platform            String   @default("LinkedIn / X")
  status              String   @default("Published")
  publishedAt         DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model Memory {
  id         String   @id @default(uuid())
  agentId    String
  topicUrl   String
  topicTitle String
  summary    String
  coveredAt  DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, topicUrl])
}

model AgentLog {
  id        String   @id @default(uuid())
  agentId   String
  level     String   @default("INFO")
  message   String
  details   String?
  createdAt DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model ImprovementAttempt {
  id                    String   @id @default(uuid())
  agentId               String
  attemptNumber         Int
  content               String
  scores                String
  weaknesses            String
  improvementSuggestions String
  finalDecision         String
  createdAt             DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model Mission {
  id        String   @id @default(uuid())
  agentId   String
  status    String   @default("RUNNING")
  result    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model EmergingTrend {
  id                String   @id @default(uuid())
  agentId           String
  title             String
  confidence        Float
  securityScore     Float
  novelty           Float
  impact            Float
  timeliness        Float
  sourceDiversity   Float
  supportingSources Int
  isPublished       Boolean  @default(false)
  createdAt         DateTime @default(now())
  
  signals           String   @default("[]") // JSON string of connected topics
  
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model Opportunity {
  id                  String   @id @default(uuid())
  agentId             String
  topic               String
  opportunityScore    Float
  momentum            Float
  aiSecurityRelevance Float
  novelty             Float
  coverageLevel       String   // "Low", "Medium", "High"
  trendPotential      Float
  trendState          String   // Declining, Stable, Growing, Rapidly Growing, Emerging
  workflowState       String   // Discovered, Monitoring, Emerging, High Opportunity, Content Creation
  recommendation      String
  explanation         String
  sourcesCount        Int
  signals             String   @default("[]")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  snapshots           TrendSnapshot[]
  agent               Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model TrendSnapshot {
  id               String   @id @default(uuid())
  opportunityId    String
  opportunityScore Float
  momentum         Float
  sourcesCount     Int
  trendState       String
  createdAt        DateTime @default(now())
  
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
}
